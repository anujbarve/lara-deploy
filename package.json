{
  "name": "laravel-deploy",
  "version": "1.0.0",
  "description": "Production-grade Laravel deployment CLI for aaPanel-managed VPS servers",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "laravel-deploy": "./dist/cli/main.js"
  },
  "files": [
    "dist",
    "scripts",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-scripts.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.3.2",
    "archiver": "^7.0.1",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "execa": "^9.5.1",
    "ora": "^8.1.1",
    "pino": "^9.4.0",
    "ssh2": "^1.15.0",
    "ssh2-sftp-client": "^9.0.4",
    "tar": "^7.4.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.2",
    "@types/node": "^22.7.4",
    "@types/ssh2": "^1.15.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.2"
  }
}